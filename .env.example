# Kuppi server environment
# Copy to .env and adjust for your deployment.

NODE_ENV=development
PORT=3100

# MySQL connection (Drizzle ORM, mysql2 dialect)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/kuppi

# Session signing secret for student auth cookies (required — any long random string)
JWT_SECRET=change_me_to_a_long_random_string

# --- Optional integrations -------------------------------------------------

# AI quiz generation via OpenRouter (server-side only; never exposed to the browser).
# Without it, every other Kuppi feature still works.
OPENROUTER_API_KEY=

# --- Storage (first match wins) --------------------------------------------
#
# 1. Manus Forge object storage (only on the Manus platform):
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# 2. S3-compatible object storage (MinIO on our Oracle Always-Free VM).
#    Takes precedence over Vercel Blob; see ops/README.md for provisioning.
#    Browser uploads stream through presigned PUTs; objects are public-read.
S3_ENDPOINT=
S3_BUCKET=kuppi-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional browser-facing base (defaults to <endpoint>/<bucket>):
S3_PUBLIC_BASE_URL=

# 3. Vercel Blob (legacy mode; kept as fallback during the MinIO migration —
#    remove once ops/migrate-vercel-blob.mjs has repointed every row):
BLOB_READ_WRITE_TOKEN=

# 4. Local disk (default for local dev / self-hosted servers):
KUPPI_STORAGE_DIR=./storage-data
